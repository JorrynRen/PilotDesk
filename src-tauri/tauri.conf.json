{
  "productName": "PilotDesk",
  "version": "0.1.0",
  "identifier": "com.pilotdesk.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "windows": [
      {
        "title": "PilotDesk",
        "width": 1200,
        "height": 815,
        "minWidth": 1020,
        "minHeight": 815,
        "decorations": false,
        "shadow": false,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://127.0.0.1:1420 http://localhost:1420; style-src 'self' 'unsafe-inline' http://127.0.0.1:1420; img-src 'self' data: https: asset: http://asset.localhost; media-src 'self' data: https: asset: http://asset.localhost; connect-src 'self' ws://localhost:* http://localhost:* http://127.0.0.1:1420; frame-src https: http: asset: http://asset.localhost http://dirindex.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": [
      "resources/agents/*",
      "resources/icons/*",
      "resources/assets/*"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/JorrynRen/PilotDesk/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5QUQ5NzRERjFCQ0QxNQpSV1FWelJ2ZmRObWFDRnRtSlphVVo5NjJ2aUtyRFhwaFd3ZktGRGZDV0lNYjhoUk9uRjdDZkdhZwo=",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}