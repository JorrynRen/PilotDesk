{
  "id": "llm-chat-node",
  "name": "LLM Chat Node",
  "version": "1.0.0",
  "description": "工作流插件节点插件，工作流插件节点中使用，选择 API 供应商和模型，通过提示词与 API配置的LLM 对话。",
  "author": "PilotDesk",
  "minAppVersion": "0.1.0",
  "icon": "icon.png",
  "entry": { "main": "index.js" },
  "contributes": {
    "panels": [
      {
        "id": "llm-chat-panel",
        "title": "LLM Chat"
      }
    ],
    "commands": [
      {
        "id": "llm-chat.chat",
        "title": "LLM 对话",
        "input": {
          "type": "object",
          "properties": {
            "api_provider_id": { "type": "string", "description": "API 供应商 ID" },
            "model": { "type": "string", "description": "模型名称" },
            "prompt": { "type": "string", "description": "用户提示词" },
            "system_prompt": { "type": "string", "description": "系统提示词（可选）" },
            "max_tokens": { "type": "integer", "description": "最大生成 token 数", "default": 4096 },
            "temperature": { "type": "number", "description": "温度", "default": 0.7 }
          },
          "required": ["api_provider_id", "model", "prompt"]
        },
        "output": {
          "type": "object",
          "properties": {
            "content": { "type": "string", "description": "LLM 回复内容" },
            "model": { "type": "string", "description": "实际使用的模型" },
            "provider": { "type": "string", "description": "供应商名称" }
          }
        }
      }
    ],
    "workflow_config": {
      "component": "PluginNodeConfig"
    }
  },
  "permissions": [
    "ui:panel",
    "ui:toast",
    "data:invoke"
  ]
}
